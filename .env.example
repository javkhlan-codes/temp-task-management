# Optional. Without this value the app runs in browser-local demo mode.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Public production origin used for social sharing metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:8000

# 32-byte base64url key used to encrypt TOTP secrets at rest.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TOTP_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64url-key
